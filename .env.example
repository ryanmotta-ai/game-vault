# ==============================================================================
# GAME VAULT - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your Google Cloud OAuth 2.0 Desktop App credentials.
# 3. Refer to docs/GOOGLE_DRIVE_SETUP.md for detailed setup instructions.
# ==============================================================================

# Google OAuth 2.0 Credentials (Type: Desktop Application)
GAMEVAULT_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GAMEVAULT_GOOGLE_CLIENT_SECRET=your-google-client-secret
